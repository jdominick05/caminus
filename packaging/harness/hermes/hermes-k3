#!/bin/sh
# hermes-k3: Hermes Agent against a local Caminus server (caminus serve, 127.0.0.1:8092), in a Hermes home of its own.
#
#   packaging/harness/hermes/hermes-k3 [hermes arguments...]          # k3-coder (thinking)
#   CAMINUS_HERMES_HOME=DIR packaging/harness/hermes/hermes-k3        # another home (default ~/.config/caminus/hermes-home)
#
# HERMES_HOME points Hermes' state (config, sessions, memory, skills, logs, auth) at CAMINUS_HERMES_HOME. A HERMES_HOME outside
# ~/.hermes (and not under a profiles/ directory) is its own root (Hermes' source: hermes_constants._hermes_root_of), so
# the root auth.json that profiles fall back to is in it too. Not verified that no other code path reads ~/.hermes.
# Do not use `hermes -p NAME` for this: profiles live under ~/.hermes/profiles. On the first run the home is created and
# config.yaml copied from this directory; after that the copy is yours to edit.
set -eu
HERE=$(cd "$(dirname "$(readlink -f "$0")")" && pwd)   # readlink: works through a symlink on PATH
HOME_DIR=${CAMINUS_HERMES_HOME:-$HOME/.config/caminus/hermes-home}
if [ ! -f "$HOME_DIR/config.yaml" ]; then
    mkdir -p "$HOME_DIR"
    chmod 700 "$HOME_DIR"
    cp "$HERE/config.yaml" "$HOME_DIR/config.yaml"
    echo "hermes-k3: created $HOME_DIR (config.yaml from $HERE)" >&2
fi
# the server's context (max_ctx auto sizes it to the cards: 262,144 is a cap, not a given): every context_length in the
# home's config.yaml set to it, rounded down to a thousand, before each launch
python3 -I - "$HOME_DIR/config.yaml" "${CAMINUS_URL:-http://127.0.0.1:8092}" <<'PYEOF' || true
import json, re, sys, urllib.request
path, url = sys.argv[1], sys.argv[2].rstrip('/')
try:
    n = int(json.load(urllib.request.urlopen(url + '/props', timeout=5))['default_generation_settings']['n_ctx'])
except Exception as e:
    sys.exit(f'hermes-k3: the server at {url} did not report its context ({e}); config.yaml kept as it is')
t = open(path).read(); w = n // 1000 * 1000
u = re.sub(r'(context_length:\s*)\d+', lambda m: m.group(1) + str(w), t)
if u != t:
    open(path, 'w').write(u); print(f'hermes-k3: context length {w} from the server', file=sys.stderr)
PYEOF
export HERMES_HOME="$HOME_DIR"
exec hermes "$@"
