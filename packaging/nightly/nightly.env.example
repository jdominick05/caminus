# The nightly build's environment: copy to ~/.config/caminus-nightly/env (mode 600) and fill in.
# systemd reads it: KEY=value lines, no quotes needed, no $VARIABLE expansion (write full paths).

# the identity of the nightly commit and tag (public)
NIGHTLY_GIT_NAME=your-github-login
NIGHTLY_GIT_EMAIL=you@example.com

# the build runs in the release build image (tools/release/in_image.sh; default: packaging/build-image/IMAGE, which the
# docker login must be able to pull). PY: a Python 3.12+ on the host for the nightly's own checks (no packages needed)
PY=/usr/bin/python3
#CAMINUS_BUILD_IMAGE=

# git, gh and docker must be on it
PATH=/usr/local/bin:/usr/bin:/bin

# only when gh keeps its token in a keyring and the timer may run without a login session (after a reboot): a
# fine-grained token for this one repository with Contents: read and write, Actions: read
#GH_TOKEN=

# optional: NIGHTLY_KEEP_BUILDS=2 (build directories kept), NIGHTLY_HOME (state; default ~/.local/state/caminus-nightly)
