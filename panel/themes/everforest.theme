# everforest: Everforest (dark), mapped onto the panel's roles.
# btop-syntax theme: key = value, full-line # comments, #rgb/#rrggbb/#rrggbbaa
# or term_N for the terminal's own palette.

text = #d3c6aa
muted = #9da9a0
think = #c5bca4
dim = #7a8478
accent = #83c092
ok = #a7c080
warn = #dbbc7f
action = #e69875
hot = #e67e80
purple = #d699b6
user = #7fbbb3
teal = #83c092
chrome = #475258

code_bg = #343f44
codeblock_bg = #2d353b
code_theme = gruvbox
