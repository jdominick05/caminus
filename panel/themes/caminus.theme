# caminus: Iron & Patina, Caminus's own palette and the default for the panel, top and Ember. The furnace's metal:
# a cast-iron background, verdigris as the accent, brass as the second colour, copper for actions (Ember's flame).
# Every text and accent colour reads at WCAG AA (4.5:1) or better on the background.
# btop-syntax theme: key = value, full-line # comments, #rgb/#rrggbb/#rrggbbaa or term_N for the terminal's own palette.

text = #ece8e1
muted = #a6aeb4
think = #cdd0cf
dim = #39424b
accent = #5fc4b0
ok = #8fd081
warn = #ecc95e
action = #e0904f
hot = #ec6f60
purple = #d9ad62
user = #7fb2e5
teal = #5fc4b0
chrome = #39424b

code_bg = #262c33
codeblock_bg = #111417
code_theme = github-dark

bg = #15181c
bg2 = #1e2328
pattern = #1b1f24
bg_pattern = none
overlay = #1c2a2a
overlay_border = #5fc4b0
